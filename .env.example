# Copy this file to `.env` and fill in the values. They are read by `src/config.py`.

PROJECT_NAME=AluBot

# Discord bot tokens: the production bot and the test bot (used with `--test`).
DISCORD_TOKEN_ALUBOT=
DISCORD_TOKEN_YENBOT=

# PostgreSQL connection string of the home database, e.g. postgresql://postgres:password@localhost:5432/postgres
# On the VPS, the systemd unit sets DATABASE_URL itself, which overrides this value.
DATABASE_URL=

# Discord webhook URLs
WEBHOOK_LOGGER=
WEBHOOK_DOTANEWS=
WEBHOOK_ERROR=
WEBHOOK_SPAM=

# Mentions that are put into the error notifications for the production and the test bot, e.g. <@123456789012345678>
PING_PROD_MENTION=
PING_TEST_MENTION=

# API tokens
WOLFRAM_TOKEN=
GIT_PERSONAL_TOKEN=

# [MONITORING]
# Optional: healthchecks.io ping URL, the bot pings it every 5 minutes while it's healthy.
# Only the VPS (a systemd service) pings it, so it's safe to keep the same value in a home .env too.
HEALTHCHECK_URL=
