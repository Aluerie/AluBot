# Copy this file to `.env` and fill in the values. They are read by `src/config.py`.

PROJECT_NAME=AluBot

# Discord bot tokens: the production bot and the test bot (used with `--test`).
DISCORD_TOKEN_ALUBOT=
DISCORD_TOKEN_YENBOT=

# PostgreSQL connection strings (production and test databases), e.g. postgresql://user:password@localhost:5432/alubot
POSTGRES_PROD=
POSTGRES_TEST=

# Discord webhook URLs
WEBHOOK_LOGGER=
WEBHOOK_DOTANEWS=
WEBHOOK_ERROR=
WEBHOOK_SPAM=

# Mentions that are put into the error notifications for the production and the test bot, e.g. <@123456789012345678>
PING_PROD_MENTION=
PING_TEST_MENTION=

# API tokens
WOLFRAM_TOKEN=
GIT_PERSONAL_TOKEN=
